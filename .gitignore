# ==============================================
# 一、系统通用缓存文件（Windows/macOS/Linux）
# ==============================================
# macOS 系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows 系统文件
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux 临时文件
*~
.fuse_hidden*
.nfs*

# ==============================================
# 二、编辑器 / IDE / 工具配置（全覆盖）
# ==============================================
# Obsidian 知识库（你的专属需求）
.obsidian/
.obsidian.v2/
trash/

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace

# JetBrains 系列（IDEA/WebStorm/GoLand/PyCharm）
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / NeoVim
*.swp
*.swo
.env

# Atom
.atom/
.c9/

# ==============================================
# 三、编程语言 核心忽略规则
# ==============================================
# --- Node.js / JavaScript / TypeScript ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# --- Python ---
venv/
env/
ENV/
.venv/
.env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
htmlcov/
.coverage
.tox/
.nox/

# --- Java / Kotlin / Spring Boot ---
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
*.class
*.jar
*.war
*.ear
*.logs

# --- Go 语言 ---
/bin/
/pkg/
/GOPATH/
*.exe
*.exe~
*.dll
*.so
*.dylib

# --- PHP / Laravel ---
vendor/
.phpunit.result.cache
.phpstan.cache
.php-cs-fixer.cache
storage/
bootstrap/cache/

# --- C / C++ / C# ---
*.o
*.obj
*.out
*.exe
*.pdb
*.ilk
*.aps
*.res

# --- Ruby ---
/.bundle/
/vendor/bundle
*.gem

# --- Rust ---
/target/
Cargo.lock

# ==============================================
# 四、前端框架 / 构建工具
# ==============================================
# 构建输出目录
dist/
build/
output/
out/
public/dist/

# 打包缓存
.parcel-cache/
.next/
.nuxt/
.svelte-kit/
.vuepress/dist/

# 依赖/缓存
.cache/
.temp/
.tmp/

# ==============================================
# 五、敏感配置 / 环境变量（禁止提交！）
# ==============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
secrets/
credentials/
*.pem
*.key
*.pfx
*.p12

# ==============================================
# 六、日志 / 临时 / 缓存文件
# ==============================================
logs/
log/
*.log
tmp/
temp/
*.tmp
*.temp
.cache/
.angular/
coverage/
.nyc_output/

# ==============================================
# 七、Docker / 容器 / 部署
# ==============================================
docker-compose.override.yml
.dockerignore
*.dockerignore

# ==============================================
# 八、其他通用忽略
# ==============================================
# 压缩包
*.zip
*.tar.gz
*.rar
*.7z

# 备份文件
*.bak
*.backup
*.old